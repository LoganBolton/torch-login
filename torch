#!/bin/bash
set -euo pipefail

script_path=${BASH_SOURCE[0]}
while [[ -L $script_path ]]; do
  script_dir=$(cd -P "$(dirname "$script_path")" && pwd)
  target=$(readlink "$script_path")
  if [[ $target == /* ]]; then
    script_path=$target
  else
    script_path=$script_dir/$target
  fi
done
script_dir=$(cd -P "$(dirname "$script_path")" && pwd)
exec /usr/bin/expect "$script_dir/torch-login.exp" "$@"
